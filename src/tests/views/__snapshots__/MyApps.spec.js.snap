// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MyApps > matches snapshot 1`] = `
"<div data-v-d693ca5e="" class="my-apps">
  <!--v-if-->
  <!--v-if-->
  <div data-v-d693ca5e="" class="my-apps__empty"><img data-v-d693ca5e="" class="my-apps__empty__image" src="/src/assets/svgs/empty-apps.svg">
    <div data-v-d693ca5e="" class="my-apps__empty__description__main">No integrations installed yet</div>
    <div data-v-d693ca5e="" class="my-apps__empty__description__secondary">
      <div data-v-d693ca5e="">Find what you need</div>
      <div data-v-d693ca5e="" class="my-apps__empty__description__secondary__link">here</div>
    </div>
  </div>
  <div data-v-7d3d5e15="" data-v-d693ca5e="">
    <!--v-if-->
    <unnnicdialog data-v-7d3d5e15="" class="config-confirmation-dialog" open="false">
      <unnnicdialogcontent data-v-7d3d5e15="" size="medium">
        <unnnicdialogheader data-v-7d3d5e15="" type="attention">
          <unnnicdialogtitle data-v-7d3d5e15="">Discard changes</unnnicdialogtitle>
        </unnnicdialogheader>
        <section data-v-7d3d5e15="" class="config-confirmation-dialog__description">Are you sure you want to discard the changes? You'll lose any unsaved content.</section>
        <unnnicdialogfooter data-v-7d3d5e15="">
          <unnnicdialogclose data-v-7d3d5e15="">
            <unnnicbutton data-v-7d3d5e15="" type="tertiary" text="Back to settings"></unnnicbutton>
          </unnnicdialogclose>
          <unnnicbutton data-v-7d3d5e15="" type="primary" text="Confirm"></unnnicbutton>
        </unnnicdialogfooter>
      </unnnicdialogcontent>
    </unnnicdialog>
  </div>
</div>"
`;
